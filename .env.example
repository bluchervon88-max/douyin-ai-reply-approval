# 飞书自建应用（需要机器人能力）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 审批群 chat id，oc_ 开头；为空时只写日志、不发卡
FEISHU_CHAT_ID=

# DeepSeek；不填则尝试 OPENCLAW_GATEWAY_CMD / ~/.openclaw/gateway.cmd
DEEPSEEK_API_KEY=

# 运行目录（默认脚本所在目录）
# DOUYIN_DM_DIR=
# Edge 登录态目录（默认 <DOUYIN_DM_DIR>/.profile）
# DOUYIN_PROFILE=
# Edge 路径
EDGE_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# 第一次登录设为 false，方便扫码；登录后可改 true
HEADLESS=false
# CDP 调试端口
CDP_PORT=9222
# 本地状态 API 端口，只绑 127.0.0.1
WATCHER_PORT=8899

# 素材目录（默认 ~/.openclaw/workspace）
# OPENCLAW_WORKSPACE=
# STICKERS_DIR=

# 人设与语料（默认 persona/）
# SOUL_PATH=
# CORPUS_PATH=
# 逗号分隔，生成语料时排除的词/人名
# CORPUS_EXCLUDE=
